0 BEGIN PGM CAMCRAFT MM
1 BLK FORM 0.1 Z X-20 Y-15 Z-8
2 BLK FORM 0.2 X+20 Y+15 Z+5
3 ; CONFIRM XYZ MODE - QUILL COUPLED - W FIXED
4 ; CONFIRM SPINDLE STOPPED - NO TILT
5 ; CANCEL ACTIVE COORDINATE TRANSFORMATIONS
6 ; CONFIRM QUILL AT UPPER CHANGE POSITION
7 ; VERIFY +Z RETRACT PATH AND CHANGE SPACE
8 ; CHECK FULL-RETRACT XY PATH FOR ALL TOOLS
9 ; VERIFY TOOL TABLE AND PRESET 2
10 ; CHECK PRESET X Y Z FILLED AND ROTATION ZERO
11 M0
12 CYCL DEF 247 DATUM SETTING ~
  Q339=+2
13 M137
14 ; OPERATION Drill
15 ; CHECK DRIVES OFF BEFORE TOUCHING TOOL
16 ; CHECK QUILL AT PHYSICAL CHANGE POSITION
17 ; ABORT IF EITHER CHECK FAILS
18 ; THEN INSTALL TOOL 3 DRILL-6
19 M0
20 TOOL CALL 3 Z S1500
21 L M140 MB MAX
22 ; CHECK ACTUAL TIP HEIGHT AND ENTIRE XY PATH
23 ; ABORT IF TOOL OR HOLDER CANNOT CLEAR
24 M0
25 M3
26 M9
27 L X+5 Y+5 R0 FMAX
28 L Z+10 R0 FMAX
29 L X+5 Y+5 Z+10 R0 FMAX
30 L X+5 Y+5 Z+6 R0 FMAX
31 CYCL DEF 200 DRILLING ~
  Q200=+1 ~
  Q201=-10 ~
  Q206=+100 ~
  Q202=+10 ~
  Q210=+0 ~
  Q203=+5 ~
  Q204=+1 ~
  Q211=+0.5
32 CYCL CALL
33 L X+5 Y+5 Z+7 R0 FMAX
34 L X+15 Y+5 Z+7 R0 FMAX
35 L X+15 Y+5 Z+6 R0 FMAX
36 CYCL CALL
37 L X+15 Y+5 Z+7 R0 FMAX
38 L X+15 Y+5 Z+10 R0 FMAX
39 M9
40 M5
41 ; OPERATION Peck
42 TOOL CALL 3 Z S1500
43 L M140 MB MAX
44 ; CHECK ACTUAL TIP HEIGHT AND ENTIRE XY PATH
45 ; ABORT IF TOOL OR HOLDER CANNOT CLEAR
46 M0
47 M3
48 M9
49 L X+5 Y-5 R0 FMAX
50 L Z+10 R0 FMAX
51 L X+5 Y-5 Z+10 R0 FMAX
52 L X+5 Y-5 Z+6 R0 FMAX
53 L X+5 Y-5 Z+2 R0 F100
54 L X+5 Y-5 Z+3 R0 FMAX
55 L X+5 Y-5 Z-2 R0 F100
56 L X+5 Y-5 Z-1 R0 FMAX
57 L X+5 Y-5 Z-5 R0 F100
58 L X+5 Y-5 Z+6 R0 FMAX
59 L X+5 Y-5 Z+7 R0 FMAX
60 L X+5 Y-5 Z+10 R0 FMAX
61 M9
62 M5
63 ; OPERATION Deep
64 TOOL CALL 3 Z S1500
65 L M140 MB MAX
66 ; CHECK ACTUAL TIP HEIGHT AND ENTIRE XY PATH
67 ; ABORT IF TOOL OR HOLDER CANNOT CLEAR
68 M0
69 M3
70 M9
71 L X+15 Y-5 R0 FMAX
72 L Z+10 R0 FMAX
73 L X+15 Y-5 Z+10 R0 FMAX
74 L X+15 Y-5 Z+6 R0 FMAX
75 L X+15 Y-5 Z+1 R0 F100
76 L X+15 Y-5 Z+6 R0 FMAX
77 L X+15 Y-5 Z-4 R0 F100
78 L X+15 Y-5 Z+6 R0 FMAX
79 L X+15 Y-5 Z-5 R0 F100
80 CYCL DEF 9.0 DWELL TIME
81 CYCL DEF 9.1 DWELL 0.3
82 L X+15 Y-5 Z+7 R0 FMAX
83 L X+15 Y-5 Z+10 R0 FMAX
84 M9
85 M5
86 ; OPERATION Rigid tap
87 L M140 MB MAX
88 ; CHECK DRIVES OFF BEFORE TOUCHING TOOL
89 ; CHECK QUILL AT PHYSICAL CHANGE POSITION
90 ; ABORT IF EITHER CHECK FAILS
91 ; THEN INSTALL TOOL 4 TAP-M6
92 M0
93 TOOL CALL 4 Z S500
94 L M140 MB MAX
95 ; CHECK ACTUAL TIP HEIGHT AND ENTIRE XY PATH
96 ; ABORT IF TOOL OR HOLDER CANNOT CLEAR
97 M0
98 M3
99 M9
100 L X+5 Y+5 R0 FMAX
101 L Z+10 R0 FMAX
102 L X+5 Y+5 Z+10 R0 FMAX
103 L X+5 Y+5 Z+6 R0 FMAX
104 CYCL DEF 207 RIGID TAPPING NEW ~
  Q200=+1 ~
  Q201=-8 ~
  Q239=+1 ~
  Q203=+5 ~
  Q204=+1
105 CYCL CALL
106 L X+5 Y+5 Z+7 R0 FMAX
107 L X+5 Y+5 Z+10 R0 FMAX
108 M9
109 M5
110 ; OPERATION Floating tap
111 L M140 MB MAX
112 ; CHECK DRIVES OFF BEFORE TOUCHING TOOL
113 ; CHECK QUILL AT PHYSICAL CHANGE POSITION
114 ; ABORT IF EITHER CHECK FAILS
115 ; THEN INSTALL TOOL 5 TAP-M6-FLOAT
116 M0
117 TOOL CALL 5 Z S500
118 L M140 MB MAX
